rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdminOrStaff() {
      return isAuthenticated() && (getUserData().role == 'ADMIN' || getUserData().role == 'STAFF');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdminOrStaff();
      // Allow user creation on signup, force role to CUSTOMER
      allow create: if isOwner(userId) && request.resource.data.role == 'CUSTOMER';
      // User can update profile/budget, but CANNOT modify their own role
      allow update: if isOwner(userId)
                    && request.resource.data.role == resource.data.role
                    || isAdminOrStaff();
      allow delete: if isAdminOrStaff();
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true; // Public read for products
      allow create, update, delete: if isAdminOrStaff();

      match /variants/{variantId} {
        allow read: if true;
        allow create, update, delete: if isAdminOrStaff();
      }
    }

    // Carts Collection
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdminOrStaff(); // Only Admin/Staff can verify exits or mark completed
    }

    // Exit Tokens Collection
    match /exitTokens/{tokenId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow create: if isAuthenticated();
      allow update: if isAdminOrStaff(); // Only Admin/Staff can verify/flag exit tokens
    }
  }
}
